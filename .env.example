# Example environment for the multimodal escalation adapter.
#
# Copy to `.env` and fill in locally. `.env` is gitignored and MUST NEVER be
# committed. This example file contains no real values by design.
#
# The adapter reads keys from the process environment only. No key is ever read
# from, or written to, configs/multimodal_providers.yaml.
#
# --- Boolean values ---------------------------------------------------------
# Every CLAIMROUTE_* flag below accepts exactly these, case-insensitively and
# ignoring surrounding whitespace:
#
#     true:   true  1  yes  on
#     false:  false 0  no   off   (and unset, and empty)
#
# Anything else is a CONFIGURATION ERROR, reported on screen rather than read as
# false. A value nobody can interpret must not be interpreted: silently treating
# `CLAIMROUTE_MULTIMODAL_ENABLED=yes please` as "off" makes "I set the flag" and
# "the flag is not set" true at the same time.
#
# --- Precedence -------------------------------------------------------------
#     secure environment override  ->  application configuration  ->  safe default
#
# The environment may OPEN a gate the tracked config leaves closed, so an
# operator can enable a session without editing committed files. Never the
# reverse: a shipped file cannot open a gate the environment closed, because the
# file travels with a clone and the environment does not.

# --- Enablement -------------------------------------------------------------
# The adapter is disabled by default in configs/multimodal_providers.yaml.
# Set this to true to allow calls for a single process without editing tracked
# config. Anything else (or unset) leaves it disabled.
#
# Declared ONCE, on purpose: a duplicated key in a dotenv file is resolved by
# whichever line the parser happens to read last, which is not a thing anyone
# should have to reason about when the answer decides whether money is spent.
CLAIMROUTE_MULTIMODAL_ENABLED=false

# --- Provider credentials ---------------------------------------------------
# Named by `api_key_env` in configs/multimodal_providers.yaml.
# Values are ALWAYS empty here. This file is tracked; a real key in it would be
# committed, and a committed key is a leaked key.
OPENAI_API_KEY=

# --- Live provider path (OpenRouter) ----------------------------------------
# The ONLY path in this repo that can spend money. It needs all four of
# OPENROUTER_API_KEY, CLAIMROUTE_MULTIMODAL_ENABLED (above), and both flags
# below. Leaving this file as-is keeps spending at exactly zero.
OPENROUTER_API_KEY=
CLAIMROUTE_LIVE_PROVIDER_TEST=false

# The activation override for `live_provider.enabled`, which ships false in
# configs/multimodal_providers.yaml and stays false there.
#
# WHY THIS EXISTS. Every other gate on the paid path already had a per-session
# route to "on". This one did not, so authorising ONE approved synthetic crop
# meant editing a tracked file — and a tracked `true` travels with the clone, to
# every machine, for every document. The safe act and the dangerous act were the
# same edit.
#
# Unlike the flags above, this one is TRI-STATE:
#     unset/empty  ->  configs/multimodal_providers.yaml decides (ships closed)
#     true         ->  live path OPEN for this process only
#     false        ->  live path CLOSED even if a checkout arrives with it on
#
# It replaces exactly one boolean. Synthetic attestation, proven crop
# provenance, the model allowlist, both budgets, duplicate protection and the
# explicit in-app confirmation are all unchanged and all still apply. Setting
# this does not authorise sending an organiser document, an arbitrary local
# claim, or a full page — those remain refused by policy the override cannot
# reach.
CLAIMROUTE_LIVE_PROVIDER_CONFIG_ENABLED=false

# --- Optional real-provider smoke test --------------------------------------
# tests/integration/test_real_multimodal_provider.py makes ONE real API call and
# skips unless this flag is 1 AND a key is present. It uses a freshly generated
# synthetic crop; it must never be pointed at organiser or real claim data.
CLAIMROUTE_REAL_PROVIDER_SMOKE=0
